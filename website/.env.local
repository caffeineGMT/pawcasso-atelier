# Stripe Price IDs for tiered pricing
# Create these products in Stripe Dashboard with the following prices:
# - Basic: $9.00 (pawcasso-basic-9)
# - Premium: $29.00 (pawcasso-premium-29)
# - Deluxe: $49.00 (pawcasso-deluxe-49)
# - Bundle: $79.00 (pawcasso-bundle-79)
STRIPE_PRICE_BASIC=price_1xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM=price_1xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_DELUXE=price_1xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUNDLE=price_1xxxxxxxxxxxxxxxxxxxxx
