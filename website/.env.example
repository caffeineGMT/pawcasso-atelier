# ============================================
# STRIPE PAYMENT CONFIGURATION
# ============================================
# ⚠️  PRODUCTION MODE: Replace 'sk_test_' with 'sk_live_' keys from Stripe Dashboard
# See STRIPE_PRODUCTION_ACTIVATION.md for complete setup guide

# Stripe API Keys (get from Stripe Dashboard > Developers > API Keys)
# 🧪 TEST MODE: sk_test_... / pk_test_... (for development/testing)
# 🔴 LIVE MODE: sk_live_... / pk_live_... (for production - REQUIRED for real payments)
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Stripe Webhook Secret (get from Stripe Dashboard > Developers > Webhooks)
# Create endpoint: https://pawcasso-atelier.vercel.app/api/webhooks/stripe
# Events: checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe Price IDs for Tiered Pricing (create these products in Stripe Dashboard)
# Basic: $9.00 - 1 portrait, 24-hour delivery
STRIPE_PRICE_BASIC=price_1xxxxxxxxxxxxxxxxxxxxx
# Premium: $29.00 - 1 portrait + 2 variations, 12-hour delivery
STRIPE_PRICE_PREMIUM=price_1xxxxxxxxxxxxxxxxxxxxx
# Deluxe: $49.00 - 3 portraits, 6-hour delivery, print-ready files
STRIPE_PRICE_DELUXE=price_1xxxxxxxxxxxxxxxxxxxxx
# Bundle: $79.00 - 5 portraits, instant delivery, commercial license
STRIPE_PRICE_BUNDLE=price_1xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs for Upsells (create these products in Stripe Dashboard)
# Print Package: $19 - High-res TIFF + PNG files with print guide
STRIPE_PRICE_PRINT_PACKAGE=price_your_print_package_id_here

# Commercial License: $99 - Commercial usage rights
STRIPE_PRICE_COMMERCIAL_LICENSE=price_your_commercial_license_id_here

# Print Upsell Products (20% discount applied - create in Stripe Dashboard)
# Framed Print: $49 (regular $59) - 12x16" museum-quality framed print
STRIPE_PRICE_PRINT_FRAMED=price_your_framed_print_id_here
# Canvas Wrap: $69 (regular $89) - 16x20" gallery-wrapped canvas
STRIPE_PRICE_PRINT_CANVAS=price_your_canvas_print_id_here
# Metal Print: $119 (regular $149) - 16x20" aluminum metal print
STRIPE_PRICE_PRINT_METAL=price_your_metal_print_id_here

# Vercel Blob Storage (get from Vercel Dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Mailchimp API Configuration (get from Mailchimp > Account > Extras > API Keys)
# API Key format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us12
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
# Server prefix is the part after the dash in your API key (e.g., us12, us6, us21)
MAILCHIMP_SERVER_PREFIX=us12
# Audience/List ID (get from Mailchimp > Audience > Settings > Audience name and defaults)
MAILCHIMP_LIST_ID=your_list_id_here

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# Live Chat - Crisp Chat (get from app.crisp.chat > Settings > Setup Instructions)
# Free plan includes unlimited conversations, bot responses, and custom triggers
NEXT_PUBLIC_CRISP_WEBSITE_ID=your_crisp_website_id_here

# OpenAI API for Quality Scoring (get from platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Manus API for AI Portrait Generation (get from manus.aws.metafb.cloud)
# Used by webhook to generate portraits after successful payment
MANUS_API_KEY=your_manus_api_key_here

# Vercel Postgres Database (get from Vercel Dashboard > Storage > Postgres)
# Connection strings for database operations
POSTGRES_URL=postgres://user:password@host:5432/database
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/database

# Resend Email Service (get from resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Admin Authentication
# Set a secure password for accessing the admin quality review dashboard at /admin/review
ADMIN_PASSWORD=your_secure_admin_password_here
DATABASE_URL="file:./prisma/dev.db"

# Google Ads Conversion Tracking (get from Google Ads > Tools > Conversions)
# See .env.google-ads.example for detailed setup instructions
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PURCHASE=XXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LABEL_ADD_TO_CART=XXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LABEL_BEGIN_CHECKOUT=XXXXXXXXXXXX

# Pinterest Tag (get from ads.pinterest.com > Conversions > Install Pinterest tag)
NEXT_PUBLIC_PINTEREST_TAG_ID=XXXXXXXXXXXXX

# Meta Conversions API (for server-side event tracking)
META_PIXEL_ACCESS_TOKEN=your_meta_capi_token_here

# Slack Webhook for Corporate Quote Notifications (get from Slack > Incoming Webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Printful API for Print-on-Demand Fulfillment (get from printful.com > Settings > Stores > API)
PRINTFUL_API_KEY=your_printful_api_key_here
