STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe Price IDs for Tiered Pricing (create these products in Stripe Dashboard)
# Basic: $9.00 - 1 portrait, 24-hour delivery
STRIPE_PRICE_BASIC=price_1xxxxxxxxxxxxxxxxxxxxx
# Premium: $29.00 - 1 portrait + 2 variations, 12-hour delivery
STRIPE_PRICE_PREMIUM=price_1xxxxxxxxxxxxxxxxxxxxx
# Deluxe: $49.00 - 3 portraits, 6-hour delivery, print-ready files
STRIPE_PRICE_DELUXE=price_1xxxxxxxxxxxxxxxxxxxxx
# Bundle: $79.00 - 5 portraits, instant delivery, commercial license
STRIPE_PRICE_BUNDLE=price_1xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs for Upsells (create these products in Stripe Dashboard)
# Print Package: $19 - High-res TIFF + PNG files with print guide
STRIPE_PRICE_PRINT_PACKAGE=price_your_print_package_id_here

# Commercial License: $99 - Commercial usage rights
STRIPE_PRICE_COMMERCIAL_LICENSE=price_your_commercial_license_id_here

# Vercel Blob Storage (get from Vercel Dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
