# Base URL
NEXT_PUBLIC_BASE_URL=https://pawcasso-atelier.vercel.app

# NextAuth (Magic Link Authentication)
NEXTAUTH_URL=https://pawcasso-atelier.vercel.app
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
EMAIL_SERVER=smtp://user:password@smtp.resend.com:587
