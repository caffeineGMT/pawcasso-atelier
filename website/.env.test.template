# Test Environment Configuration Template
#
# Copy this file to .env.test and fill in the values
# These credentials are for Stripe TEST MODE only - never use production keys
#
# Get your test keys from: https://dashboard.stripe.com/test/apikeys

# Stripe Test Mode Keys (starts with pk_test_ and sk_test_)
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY_TEST=sk_test_YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Stripe Webhook Secret (for webhook signature validation)
# Get this from: https://dashboard.stripe.com/test/webhooks
# Format: whsec_xxx
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Database URL (test database)
# Use a separate test database to avoid polluting production data
DATABASE_URL="file:./test.db"

# NextAuth Configuration (for authentication tests)
NEXTAUTH_SECRET="test-secret-key-for-development-only"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration (use test mode or mock service)
# Option 1: Resend test key
RESEND_API_KEY=re_test_YOUR_RESEND_TEST_KEY

# Option 2: Use ethereal.email for test emails
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your-ethereal-user
# SMTP_PASS=your-ethereal-pass

# Test Mode Flag
NODE_ENV=test

# Optional: Vercel Blob for file upload tests
# BLOB_READ_WRITE_TOKEN=vercel_blob_test_token

# Optional: Analytics (disable in tests)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

#
# IMPORTANT NOTES:
#
# 1. Never commit .env.test with real credentials
# 2. Test keys are safe to share in development but keep them private
# 3. Webhook secret must match your Stripe dashboard webhook endpoint
# 4. Use a separate test database to avoid data corruption
# 5. Test emails should go to a test inbox (ethereal.email or mailtrap.io)
#
# Stripe Test Cards:
# - 4242424242424242: Success
# - 4000000000009995: Declined
# - 4000000000009987: Insufficient funds
# - 4000000000009979: Expired
# - 4000002500003155: 3D Secure
# - 4000008260003178: 3D Secure challenge
#
# Full list: https://stripe.com/docs/testing#cards
#
