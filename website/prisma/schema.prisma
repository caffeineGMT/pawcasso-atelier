// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Influencer {
  id                String              @id @default(cuid())
  name              String
  handle            String              @unique
  platform          String              // "instagram" or "tiktok"
  followerCount     Int
  email             String?
  status            String              @default("identified") // identified, contacted, responded, agreed, posted, declined
  discountCode      String?             @unique
  affiliateLink     String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  contactedAt       DateTime?
  respondedAt       DateTime?
  agreedAt          DateTime?
  postedAt          DateTime?
  portraitSent      Boolean             @default(false)
  notes             String?
  profileUrl        String?
  estimatedReach    Int?                // calculated from follower count
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  outreachMessages  OutreachMessage[]
  conversions       InfluencerConversion[]
}

model OutreachMessage {
  id            String      @id @default(cuid())
  influencerId  String
  influencer    Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  message       String
  sentAt        DateTime    @default(now())
  responseText  String?
  respondedAt   DateTime?
}

model InfluencerConversion {
  id            String      @id @default(cuid())
  influencerId  String
  influencer    Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  orderId       String
  revenue       Float       // in dollars
  commission    Float       // in dollars (15%)
  conversionDate DateTime   @default(now())
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
}

// Customer Referral Program
model Customer {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String?
  referralCode        String              @unique  // Unique referral code (e.g., "FLUFFY2024")
  stripeCustomerId    String?             @unique
  creditBalance       Float               @default(0)  // Credit balance in dollars
  totalReferrals      Int                 @default(0)  // Total successful referrals
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  referralsGiven      Referral[]          @relation("ReferrerCustomer")
  referralsReceived   Referral[]          @relation("ReferredCustomer")
  creditTransactions  CreditTransaction[]
  milestones          MilestoneAchievement[]
}

model Referral {
  id                String    @id @default(cuid())
  referrerEmail     String    // Email of person who referred
  referredEmail     String    // Email of person who was referred
  referralCode      String    // The code that was used
  clickedAt         DateTime? // When the referral link was first clicked
  convertedAt       DateTime? // When the referred person made a purchase
  orderId           String?   // Stripe session ID of the purchase
  orderValue        Float?    // Value of the order in dollars
  referrerCredit    Float     @default(5.0)  // $5 credit for referrer
  referredDiscount  Float     @default(0.2)  // 20% discount for referred
  status            String    @default("pending")  // pending, clicked, converted
  createdAt         DateTime  @default(now())

  referrer          Customer  @relation("ReferrerCustomer", fields: [referrerEmail], references: [email])
  referred          Customer? @relation("ReferredCustomer", fields: [referredEmail], references: [email])

  @@index([referralCode])
  @@index([referrerEmail])
  @@index([referredEmail])
}

model CreditTransaction {
  id            String    @id @default(cuid())
  customerEmail String
  amount        Float     // Positive for credit, negative for spend
  type          String    // "referral_bonus", "credit_applied", "milestone_reward"
  description   String
  referralId    String?   // Link to referral if applicable
  orderId       String?   // Link to order if applicable
  createdAt     DateTime  @default(now())

  customer      Customer  @relation(fields: [customerEmail], references: [email])

  @@index([customerEmail])
}

model MilestoneAchievement {
  id            String    @id @default(cuid())
  customerEmail String
  milestone     String    // "5_referrals", "10_referrals", etc.
  reward        String    // Description of reward
  achievedAt    DateTime  @default(now())
  claimed       Boolean   @default(false)

  customer      Customer  @relation(fields: [customerEmail], references: [email])

  @@unique([customerEmail, milestone])
}

// Customer Reviews & UGC
model CustomerReview {
  id                String    @id @default(cuid())
  customerEmail     String
  customerName      String
  petName           String
  rating            Int       // 1-5 stars
  reviewText        String    // Written review
  petPhotoUrl       String?   // Original pet photo customer uploaded
  portraitUrl       String?   // Final portrait we delivered
  instagramHandle   String?   // Customer's Instagram handle
  instagramPostUrl  String?   // Link to their Instagram post if they shared
  featured          Boolean   @default(false)  // Admin can feature on homepage
  approved          Boolean   @default(false)  // Admin approval before showing publicly
  submittedAt       DateTime  @default(now())
  approvedAt        DateTime?

  // Metadata
  artStyle          String?   // Which art style they ordered
  orderValue        Float?    // Order value in dollars

  @@index([approved])
  @@index([featured])
  @@index([customerEmail])
}

model SocialProofStats {
  id                String    @id @default(cuid())
  totalCustomers    Int       @default(0)
  totalPortraits    Int       @default(0)
  averageRating     Float     @default(4.9)
  totalReviews      Int       @default(0)
  instagramFollowers Int      @default(0)
  updatedAt         DateTime  @updatedAt
}

model InstagramPost {
  id                String    @id @default(cuid())
  instagramPostId   String    @unique  // Instagram post ID
  customerEmail     String?
  imageUrl          String    // Instagram image URL
  caption           String?
  likes             Int       @default(0)
  comments          Int       @default(0)
  postedAt          DateTime
  featured          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([featured])
}

// Order tracking for revenue analytics
model Order {
  id                    String    @id @default(cuid())
  stripeSessionId       String    @unique
  stripePaymentIntentId String?   @unique
  customerEmail         String
  customerName          String

  // Order details
  tier                  String    // basic, premium, deluxe, bundle
  tierName              String
  amount                Float     // Total amount in dollars
  subtotal              Float     // Amount before discounts
  discount              Float     @default(0) // Discount amount
  tax                   Float     @default(0)

  // Product details
  petName               String
  style                 String
  notes                 String?
  petPhotoUrl           String?
  portraitUrls          String?   // Comma-separated URLs
  portraitCount         Int       @default(1)

  // Acquisition tracking
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  referralCode          String?
  discountCode          String?
  pricingBadge          String?   // Badge shown at purchase time (e.g., "Most Popular", "Best Value")

  // Status
  status                String    @default("pending") // pending, completed, refunded, failed
  deliveryStatus        String    @default("pending") // pending, completed, failed
  deliveredAt           DateTime?

  // Refund tracking
  refunded              Boolean   @default(false)
  refundedAt            DateTime?
  refundAmount          Float     @default(0)

  // Timestamps
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmMedium])
  @@index([referralCode])
}
