// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Influencer {
  id                String              @id @default(cuid())
  name              String
  handle            String              @unique
  platform          String              // "instagram" or "tiktok"
  followerCount     Int
  email             String?
  status            String              @default("identified") // identified, contacted, responded, agreed, posted, declined
  discountCode      String?             @unique
  affiliateLink     String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  contactedAt       DateTime?
  respondedAt       DateTime?
  agreedAt          DateTime?
  postedAt          DateTime?
  portraitSent      Boolean             @default(false)
  notes             String?
  profileUrl        String?
  estimatedReach    Int?                // calculated from follower count
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  outreachMessages  OutreachMessage[]
  conversions       InfluencerConversion[]
}

model OutreachMessage {
  id            String      @id @default(cuid())
  influencerId  String
  influencer    Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  message       String
  sentAt        DateTime    @default(now())
  responseText  String?
  respondedAt   DateTime?
}

model InfluencerConversion {
  id            String      @id @default(cuid())
  influencerId  String
  influencer    Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  orderId       String
  revenue       Float       // in dollars
  commission    Float       // in dollars (15%)
  conversionDate DateTime   @default(now())
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
}

// Customer Referral Program
model Customer {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String?
  referralCode        String              @unique  // Unique referral code (e.g., "FLUFFY2024")
  stripeCustomerId    String?             @unique
  creditBalance       Float               @default(0)  // Credit balance in dollars
  totalReferrals      Int                 @default(0)  // Total successful referrals
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  referralsGiven      Referral[]          @relation("ReferrerCustomer")
  referralsReceived   Referral[]          @relation("ReferredCustomer")
  creditTransactions  CreditTransaction[]
  milestones          MilestoneAchievement[]
}

model Referral {
  id                String    @id @default(cuid())
  referrerEmail     String    // Email of person who referred
  referredEmail     String    // Email of person who was referred
  referralCode      String    // The code that was used
  clickedAt         DateTime? // When the referral link was first clicked
  convertedAt       DateTime? // When the referred person made a purchase
  orderId           String?   // Stripe session ID of the purchase
  orderValue        Float?    // Value of the order in dollars
  referrerCredit    Float     @default(5.0)  // $5 credit for referrer
  referredDiscount  Float     @default(0.2)  // 20% discount for referred
  status            String    @default("pending")  // pending, clicked, converted
  createdAt         DateTime  @default(now())

  referrer          Customer  @relation("ReferrerCustomer", fields: [referrerEmail], references: [email])
  referred          Customer? @relation("ReferredCustomer", fields: [referredEmail], references: [email])

  @@index([referralCode])
  @@index([referrerEmail])
  @@index([referredEmail])
}

model CreditTransaction {
  id            String    @id @default(cuid())
  customerEmail String
  amount        Float     // Positive for credit, negative for spend
  type          String    // "referral_bonus", "credit_applied", "milestone_reward"
  description   String
  referralId    String?   // Link to referral if applicable
  orderId       String?   // Link to order if applicable
  createdAt     DateTime  @default(now())

  customer      Customer  @relation(fields: [customerEmail], references: [email])

  @@index([customerEmail])
}

model MilestoneAchievement {
  id            String    @id @default(cuid())
  customerEmail String
  milestone     String    // "5_referrals", "10_referrals", etc.
  reward        String    // Description of reward
  achievedAt    DateTime  @default(now())
  claimed       Boolean   @default(false)

  customer      Customer  @relation(fields: [customerEmail], references: [email])

  @@unique([customerEmail, milestone])
}
