// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Influencer {
  id               String                 @id @default(cuid())
  name             String
  handle           String                 @unique
  platform         String // "instagram" or "tiktok"
  followerCount    Int
  email            String?
  status           String                 @default("identified") // identified, contacted, responded, agreed, posted, declined
  discountCode     String?                @unique
  affiliateLink    String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  contactedAt      DateTime?
  respondedAt      DateTime?
  agreedAt         DateTime?
  postedAt         DateTime?
  portraitSent     Boolean                @default(false)
  notes            String?
  profileUrl       String?
  estimatedReach   Int? // calculated from follower count
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  outreachMessages OutreachMessage[]
  conversions      InfluencerConversion[]
}

model OutreachMessage {
  id           String     @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  message      String
  sentAt       DateTime   @default(now())
  responseText String?
  respondedAt  DateTime?
}

model InfluencerConversion {
  id             String     @id @default(cuid())
  influencerId   String
  influencer     Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  orderId        String
  revenue        Float // in dollars
  commission     Float // in dollars (15%)
  conversionDate DateTime   @default(now())
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
}

// Customer Referral Program
model Customer {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  name               String?
  referralCode       String                 @unique // Unique referral code (e.g., "FLUFFY2024")
  stripeCustomerId   String?                @unique
  creditBalance      Float                  @default(0) // Credit balance in dollars
  totalReferrals     Int                    @default(0) // Total successful referrals
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  referralsGiven     Referral[]             @relation("ReferrerCustomer")
  referralsReceived  Referral[]             @relation("ReferredCustomer")
  creditTransactions CreditTransaction[]
  milestones         MilestoneAchievement[]
}

model Referral {
  id               String    @id @default(cuid())
  referrerEmail    String // Email of person who referred
  referredEmail    String // Email of person who was referred
  referralCode     String // The code that was used
  clickedAt        DateTime? // When the referral link was first clicked
  convertedAt      DateTime? // When the referred person made a purchase
  orderId          String? // Stripe session ID of the purchase
  orderValue       Float? // Value of the order in dollars
  referrerCredit   Float     @default(5.0) // $5 credit for referrer
  referredDiscount Float     @default(0.2) // 20% discount for referred
  status           String    @default("pending") // pending, clicked, converted
  createdAt        DateTime  @default(now())

  referrer Customer  @relation("ReferrerCustomer", fields: [referrerEmail], references: [email])
  referred Customer? @relation("ReferredCustomer", fields: [referredEmail], references: [email])

  @@index([referralCode])
  @@index([referrerEmail])
  @@index([referredEmail])
}

model CreditTransaction {
  id            String   @id @default(cuid())
  customerEmail String
  amount        Float // Positive for credit, negative for spend
  type          String // "referral_bonus", "credit_applied", "milestone_reward"
  description   String
  referralId    String? // Link to referral if applicable
  orderId       String? // Link to order if applicable
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerEmail], references: [email])

  @@index([customerEmail])
}

model MilestoneAchievement {
  id            String   @id @default(cuid())
  customerEmail String
  milestone     String // "5_referrals", "10_referrals", etc.
  reward        String // Description of reward
  achievedAt    DateTime @default(now())
  claimed       Boolean  @default(false)

  customer Customer @relation(fields: [customerEmail], references: [email])

  @@unique([customerEmail, milestone])
}

// Customer Reviews & UGC
model CustomerReview {
  id               String    @id @default(cuid())
  customerEmail    String
  customerName     String
  petName          String
  rating           Int // 1-5 stars
  reviewText       String // Written review
  petPhotoUrl      String? // Original pet photo customer uploaded
  portraitUrl      String? // Final portrait we delivered
  instagramHandle  String? // Customer's Instagram handle
  instagramPostUrl String? // Link to their Instagram post if they shared
  featured         Boolean   @default(false) // Admin can feature on homepage
  approved         Boolean   @default(false) // Admin approval before showing publicly
  submittedAt      DateTime  @default(now())
  approvedAt       DateTime?

  // Metadata
  artStyle   String? // Which art style they ordered
  orderValue Float? // Order value in dollars

  @@index([approved])
  @@index([featured])
  @@index([customerEmail])
}

model SocialProofStats {
  id                 String   @id @default(cuid())
  totalCustomers     Int      @default(0)
  totalPortraits     Int      @default(0)
  averageRating      Float    @default(4.9)
  totalReviews       Int      @default(0)
  instagramFollowers Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model InstagramPost {
  id              String   @id @default(cuid())
  instagramPostId String   @unique // Instagram post ID
  customerEmail   String?
  imageUrl        String // Instagram image URL
  caption         String?
  likes           Int      @default(0)
  comments        Int      @default(0)
  postedAt        DateTime
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([featured])
}

// Order tracking for revenue analytics
model Order {
  id                    String  @id @default(cuid())
  stripeSessionId       String  @unique
  stripePaymentIntentId String? @unique
  customerEmail         String
  customerName          String

  // Order details
  tier     String // basic, premium, deluxe, bundle
  tierName String
  amount   Float // Total amount in dollars
  subtotal Float // Amount before discounts
  discount Float  @default(0) // Discount amount
  tax      Float  @default(0)

  // Product details
  petName       String
  style         String
  notes         String?
  petPhotoUrl   String?
  portraitUrls  String? // Comma-separated URLs
  portraitCount Int     @default(1)

  // Acquisition tracking
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referralCode String?
  discountCode String?
  pricingBadge String? // Badge shown at purchase time (e.g., "Most Popular", "Best Value")

  // Gift card payment tracking
  giftCardCode   String? // Gift card code used (if any)
  giftCardAmount Float   @default(0) // Amount paid with gift card

  // Status
  status         String    @default("pending") // pending, completed, refunded, failed
  deliveryStatus String    @default("pending") // pending, completed, failed
  deliveredAt    DateTime?

  // Refund tracking
  refunded     Boolean   @default(false)
  refundedAt   DateTime?
  refundAmount Float     @default(0)

  // Post-delivery email tracking
  reviewEmailSentAt DateTime? // When the 7-day review request email was sent

  // Timestamps
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmMedium])
  @@index([referralCode])
  @@index([giftCardCode])
  @@index([deliveredAt])
}

// Corporate Bulk Orders (B2B)
model CorporateInquiry {
  id                    String    @id @default(cuid())
  companyName           String
  contactName           String
  email                 String
  teamSize              Int // Number of portraits requested
  useCase               String // holiday_gifts, employee_appreciation, team_building, pet_adoption_benefit, other
  preferredDeliveryDate DateTime?
  notes                 String? // Additional details from form

  // Pricing & Quote
  estimatedValue Float? // Auto-calculated based on team size
  quoteAmount    Float? // Custom quote amount set by admin
  quotedAt       DateTime?

  // Status tracking
  status     String    @default("PENDING") // PENDING, QUOTED, WON, LOST
  wonAt      DateTime?
  lostReason String?

  // UTM tracking
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model CorporateOrder {
  id              String              @id @default(cuid())
  companyName     String
  contactName     String
  contactEmail    String
  tier            String // basic, premium, deluxe
  employeeCount   Int // Total employees in this order
  totalAmount     Float // Total order value
  stripeInvoiceId String?             @unique
  paymentStatus   String              @default("PENDING") // PENDING, PAID, FAILED
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  employees       CorporateEmployee[]

  @@index([contactEmail])
  @@index([paymentStatus])
  @@index([createdAt])
}

model CorporateEmployee {
  id                  String         @id @default(cuid())
  corporateOrderId    String
  corporateOrder      CorporateOrder @relation(fields: [corporateOrderId], references: [id], onDelete: Cascade)
  employeeName        String
  employeeEmail       String
  petPhotoUrl         String?
  uploadToken         String?        @unique // Unique token for upload URL
  portraitUrl         String?
  status              String         @default("PENDING_PHOTO") // PENDING_PHOTO, PHOTO_UPLOADED, GENERATED, DELIVERED
  emailSent           Boolean        @default(false)
  emailSentAt         DateTime?
  photoUploadedAt     DateTime?
  portraitGeneratedAt DateTime?
  portraitDeliveredAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([employeeEmail])
  @@index([uploadToken])
  @@index([status])
  @@index([corporateOrderId])
}

// Gift Card System
model GiftCard {
  id             String @id @default(cuid())
  code           String @unique // Unique gift card code (e.g., "GIFT-ABCD-1234")
  initialBalance Float // Initial value in dollars
  currentBalance Float // Current balance in dollars

  // Purchase info
  purchaserEmail String? // Who bought this gift card
  purchaserName  String?
  recipientEmail String? // Who received it
  recipientName  String?

  // Referral mechanism (10% credit to sender on first use)
  senderCredited     Boolean @default(false) // Has sender received 10% credit?
  senderCreditAmount Float   @default(0) // Amount credited to sender

  // Status
  active    Boolean   @default(true)
  expiresAt DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  firstUsedAt DateTime? // When first used by recipient

  // Transactions
  transactions GiftCardTransaction[]

  @@index([code])
  @@index([purchaserEmail])
  @@index([recipientEmail])
}

model GiftCardTransaction {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])

  amount      Float // Amount used (positive) or added (negative for refunds)
  type        String // "purchase", "redemption", "refund"
  description String

  orderId       String? // Related order if this was a redemption
  balanceBefore Float // Balance before transaction
  balanceAfter  Float // Balance after transaction

  createdAt DateTime @default(now())

  @@index([giftCardId])
  @@index([orderId])
}

// Fulfillment Error Logging
model FulfillmentErrorLog {
  id              String    @id @default(cuid())
  orderId         String? // Link to Order if exists
  stripeSessionId String // Stripe checkout session ID
  customerEmail   String
  errorType       String // "download_failed", "generation_failed", "upload_failed", "email_failed", "timeout", "unknown"
  errorMessage    String
  stackTrace      String?
  step            String // Which fulfillment step failed: "downloading_photo", "generating", "uploading", "sending_email"
  metadata        String? // JSON string with session metadata for debugging
  retryCount      Int       @default(0)
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String? // "auto_retry" or "manual_retry" or "admin"
  createdAt       DateTime  @default(now())

  @@index([stripeSessionId])
  @@index([resolved])
  @@index([createdAt])
}

// Analytics Event Tracking
model AnalyticsEvent {
  id        String  @id @default(cuid())
  eventName String // 'page_view', 'gallery_view', 'order_start', 'checkout_start', 'purchase_complete', 'subscription_start'
  sessionId String  @default(cuid())
  userId    String? // Customer email if known

  // UTM parameters
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Page context
  pathname String
  referrer String?

  // Event metadata (JSON)
  metadata String? // Store as JSON string: {tier, amount, etc.}

  // Revenue tracking
  revenue Float @default(0)

  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([sessionId])
  @@index([userId])
  @@index([utmSource])
  @@index([createdAt])
}

// Marketing Spend Tracking (CAC Dashboard)
model MarketingSpend {
  id          String   @id @default(cuid())
  channel     String // google_ads, instagram, pinterest, reddit, tiktok, facebook, email, influencer, organic
  amount      Float // Spend in dollars
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0) // Attributed purchases
  revenue     Float    @default(0) // Revenue from attributed conversions
  date        DateTime // The date this spend applies to
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channel, date])
  @@index([channel])
  @@index([date])
}

// Cart Abandonment Recovery
model AbandonedCart {
  id              String @id @default(cuid())
  stripeSessionId String @unique // Stripe checkout session ID
  customerEmail   String
  customerName    String

  // Order details (what they were buying)
  tier        String // basic, premium, deluxe, bundle
  amount      Float // Total amount in dollars
  petName     String
  style       String
  notes       String?
  petPhotoUrl String?

  // Acquisition tracking
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referralCode String?
  discountCode String?

  // Recovery tracking
  status           String @default("abandoned") // abandoned, email1_sent, email2_sent, email3_sent, recovered, expired
  recoveryAttempts Int    @default(0) // Number of recovery emails sent

  // Recovery email timestamps
  email1SentAt DateTime? // 1hr email
  email2SentAt DateTime? // 24hr email
  email3SentAt DateTime? // 72hr email

  // Recovery discount codes (progressive escalation)
  discountCode1 String? // 10% discount
  discountCode2 String? // 15% discount
  discountCode3 String? // 20% discount

  // Recovery outcome
  recovered        Boolean   @default(false)
  recoveredAt      DateTime?
  recoveredOrderId String? // Link to Order if recovered

  // Timestamps
  createdAt DateTime @default(now())
  expiresAt DateTime // 7 days from creation

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([recovered])
}

// Funnel Analytics - Track conversion funnel progression and drop-off
model FunnelEvent {
  id        String   @id @default(cuid())
  sessionId String // Unique session ID for tracking user journey
  step      String // landing, gallery, order_page, photo_upload, tier_selection, checkout_initiate, purchase
  timestamp DateTime @default(now())
  metadata  String? // JSON string with additional context

  @@index([sessionId])
  @@index([step])
  @@index([timestamp])
}

// Loyalty Program
model LoyaltyMember {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  tier               String    @default("bronze") // bronze, silver, gold, platinum
  totalOrders        Int       @default(0)
  totalSpent         Float     @default(0)
  lifetimePoints     Int       @default(0)
  currentPoints      Int       @default(0)
  repeatDiscountCode String?   @unique // Auto-generated 20% off code for 2nd purchase
  repeatDiscountUsed Boolean   @default(false)
  tierUpgradedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  petProfiles PetProfile[]
  rewards     LoyaltyReward[]

  @@index([email])
  @@index([tier])
}

model PetProfile {
  id              String        @id @default(cuid())
  loyaltyMemberId String
  loyaltyMember   LoyaltyMember @relation(fields: [loyaltyMemberId], references: [id], onDelete: Cascade)
  name            String
  species         String        @default("dog") // dog, cat, bird, rabbit, etc.
  breed           String?
  birthday        DateTime? // Pet's birthday for birthday portrait reminders
  birthdayMonth   Int? // 1-12, extracted for easy querying
  birthdayDay     Int? // 1-31, extracted for easy querying
  photoUrl        String? // Reference photo
  portraitCount   Int           @default(0) // How many portraits ordered for this pet
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([loyaltyMemberId])
  @@index([birthdayMonth, birthdayDay])
}

model LoyaltyReward {
  id              String        @id @default(cuid())
  loyaltyMemberId String
  loyaltyMember   LoyaltyMember @relation(fields: [loyaltyMemberId], references: [id], onDelete: Cascade)
  type            String // "repeat_discount", "birthday_portrait", "tier_upgrade", "points_reward"
  description     String
  discountCode    String?       @unique
  discountPercent Int?
  discountAmount  Float?
  used            Boolean       @default(false)
  usedAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([loyaltyMemberId])
  @@index([discountCode])
  @@index([expiresAt])
}

// A/B Testing - Track variant assignments and conversions
model ABTestEvent {
  id        String   @id @default(cuid())
  testId    String // Test identifier (e.g., "pricing_test", "cta_button_test")
  variant   String // control, variant_a, variant_b, variant_c
  sessionId String // User session ID
  eventType String // assignment, conversion
  revenue   Float    @default(0) // Revenue from conversion (if applicable)
  metadata  String? // JSON string with additional context
  timestamp DateTime @default(now())

  @@index([testId])
  @@index([variant])
  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
}

// Instagram Content Tracking - Track generated content and performance
model InstagramContent {
  id          String   @id @default(cuid())
  contentId   String   @unique // Generated content ID from ig-queue (e.g., "8a4a00d3")
  contentType String // portrait, emoji_set, zodiac, reel
  title       String
  description String?
  animal      String // Dog, Cat, Rabbit, etc.
  breed       String?
  style       String // Art style used

  // Caption & posting details
  captionTone      String? // witty, heartfelt, minimal, bold
  captionText      String?
  hashtags         String? // JSON array of hashtags
  postedAt         DateTime?
  bestPostingTime  String? // Recommended posting time
  postingReasoning String? // Why this time was recommended

  // Instagram media details
  instagramMediaId   String? @unique // Instagram media ID after posting
  instagramPostUrl   String? // Instagram post URL
  instagramMediaType String? // IMAGE, CAROUSEL_ALBUM, VIDEO

  // Status tracking
  status String @default("generated") // generated, queued, posted, archived

  // Engagement metrics (updated periodically)
  likes            Int       @default(0)
  comments         Int       @default(0)
  saves            Int       @default(0)
  shares           Int       @default(0)
  reach            Int       @default(0)
  impressions      Int       @default(0)
  engagementRate   Float     @default(0)
  lastMetricsSync  DateTime?
  metricsSnapshots EngagementSnapshot[]

  // Metadata
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contentType])
  @@index([status])
  @@index([postedAt])
  @@index([animal])
  @@index([breed])
  @@index([engagementRate])
}

// Engagement Snapshots - Track engagement over time
model EngagementSnapshot {
  id                 String            @id @default(cuid())
  instagramContentId String
  instagramContent   InstagramContent  @relation(fields: [instagramContentId], references: [id], onDelete: Cascade)

  // Metrics at this snapshot
  likes       Int
  comments    Int
  saves       Int
  shares      Int
  reach       Int
  impressions Int

  // Calculated metrics
  engagementRate Float // (likes + comments + saves) / reach
  viralityScore  Float // (shares + saves) / impressions

  // Snapshot metadata
  hoursAfterPost Int // Hours since post was published
  capturedAt     DateTime @default(now())

  @@index([instagramContentId])
  @@index([capturedAt])
  @@index([hoursAfterPost])
}

// Content Performance Insights - AI-generated insights
model ContentInsight {
  id            String   @id @default(cuid())
  insightType   String // best_content_type, optimal_posting_time, trending_animal, caption_tone_winner
  title         String
  description   String
  recommendation String // Actionable recommendation
  confidence    Float // 0-1 confidence score
  dataPoints    Int // Number of posts analyzed
  metadata      String? // JSON with additional context

  // Validity period
  validFrom DateTime @default(now())
  validUntil DateTime? // When this insight expires/needs refresh
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([insightType])
  @@index([active])
  @@index([validFrom])
}

// Subscription System - Monthly Pet Portrait Subscription ($29/mo = 1 portrait/month)
model Subscription {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique // Stripe subscription ID
  stripeCustomerId     String // Stripe customer ID
  customerEmail        String
  customerName         String

  // Subscription details
  plan              String   @default("monthly_portrait") // monthly_portrait
  amount            Float    @default(29.0) // $29/month
  currency          String   @default("usd")
  interval          String   @default("month") // month, year
  intervalCount     Int      @default(1)
  portraitsPerMonth Int      @default(1) // Number of portraits per billing period

  // Status
  status            String   @default("active") // active, canceled, past_due, unpaid, trialing
  cancelAtPeriodEnd Boolean  @default(false) // True if customer requested cancellation
  canceledAt        DateTime?

  // Billing periods
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?

  // Payment method
  defaultPaymentMethodId String?

  // Usage tracking
  portraitsUsedThisPeriod Int @default(0) // How many portraits ordered this billing period
  portraitsRemainingThisPeriod Int @default(1) // Portraits left this period

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Relations
  orders   SubscriptionOrder[]
  invoices SubscriptionInvoice[]
  usage    SubscriptionUsage[]

  @@index([customerEmail])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([currentPeriodEnd])
}

// Subscription Orders - Track portraits ordered via subscription
model SubscriptionOrder {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Order details (similar to regular Order model)
  customerEmail String
  petName       String
  style         String
  notes         String?
  petPhotoUrl   String?
  portraitUrls  String? // Comma-separated URLs

  // Status
  status         String    @default("pending") // pending, completed, failed
  deliveryStatus String    @default("pending") // pending, completed, failed
  deliveredAt    DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  orderedAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([customerEmail])
  @@index([status])
}

// Subscription Invoices - Track Stripe invoices for subscriptions
model SubscriptionInvoice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  stripeInvoiceId String @unique // Stripe invoice ID
  amount          Float // Amount in dollars
  currency        String @default("usd")
  status          String // draft, open, paid, void, uncollectible

  // Billing period this invoice covers
  periodStart DateTime
  periodEnd   DateTime

  // Payment tracking
  paid             Boolean   @default(false)
  paidAt           DateTime?
  attemptCount     Int       @default(0)
  nextPaymentRetry DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([paid])
}

// Subscription Usage - Track portrait quota usage per billing period
model SubscriptionUsage {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Usage details
  periodStart      DateTime // Start of billing period
  periodEnd        DateTime // End of billing period
  portraitsAllowed Int // How many portraits allowed this period
  portraitsUsed    Int      @default(0) // How many portraits ordered
  portraitsRemaining Int // Portraits left this period

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId])
  @@index([periodEnd])
}

// Promotional Code System - Database-backed promo codes with advanced rules
model PromoCode {
  id          String @id @default(cuid())
  code        String @unique // The actual promo code (e.g., "BLACKFRIDAY50")
  name        String // Internal name for the campaign (e.g., "Black Friday 2026")
  description String? // Internal notes about this promo code

  // Discount configuration
  discountType    String // "percent" or "fixed_amount"
  discountPercent Int? // Percentage discount (e.g., 50 for 50% off)
  discountAmount  Float? // Fixed dollar discount (e.g., 10.00 for $10 off)
  minOrderAmount  Float? // Minimum order amount required to use this code

  // Usage limits
  maxUses          Int? // Maximum total uses (null = unlimited)
  maxUsesPerCustomer Int    @default(1) // Max uses per customer email
  currentUses      Int    @default(0) // Current total uses

  // Applicable tiers (null = all tiers)
  applicableTiers String? // JSON array of tier IDs (e.g., '["premium","deluxe"]')

  // Time restrictions
  startsAt  DateTime? // When this code becomes active (null = immediately)
  expiresAt DateTime? // When this code expires (null = never expires)

  // Status
  active Boolean @default(true) // Can be toggled off without deleting

  // Campaign tracking
  campaignType String? // "black_friday", "cyber_monday", "holiday", "flash_sale", etc.
  utmCampaign  String? // UTM campaign tag for tracking

  // Stripe integration
  stripeCouponId String? // Linked Stripe coupon ID for automatic application

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin user who created this code

  // Relations
  usages PromoCodeUsage[]

  @@index([code])
  @@index([active])
  @@index([campaignType])
  @@index([expiresAt])
}

// Promo Code Usage Tracking
model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  // Customer info
  customerEmail String
  customerName  String?

  // Order info
  orderId         String @unique // Stripe session ID or order ID
  discountApplied Float // Actual discount amount in dollars

  // Metadata
  orderAmount Float // Original order amount before discount
  finalAmount Float // Final amount after discount

  // Timestamps
  usedAt DateTime @default(now())

  @@index([promoCodeId])
  @@index([customerEmail])
  @@index([usedAt])
}

// Holiday Bundle Configuration
model HolidayBundle {
  id          String @id @default(cuid())
  slug        String @unique // URL-friendly slug (e.g., "family-3-pack")
  name        String // Display name (e.g., "Family 3-Pack Bundle")
  description String
  tagline     String? // Short promotional tagline

  // Pricing
  originalPrice Float // Original total price
  bundlePrice   Float // Discounted bundle price
  savings       Float // Amount saved

  // Bundle contents
  portraitCount   Int     @default(3) // Number of portraits in this bundle
  tierEquivalent  String? // Which tier this is based on (e.g., "premium")
  features        String // JSON array of features
  bonusFeatures   String? // JSON array of bonus features (e.g., ["Free gift wrapping"])

  // Holiday theming
  holidayTheme String? // "christmas", "black_friday", "valentines", etc.
  emoji        String? // Theme emoji
  primaryColor String? // Theme color hex
  accentColor  String? // Accent color hex

  // Availability
  active    Boolean   @default(true)
  startsAt  DateTime? // When bundle becomes available
  expiresAt DateTime? // When bundle expires

  // Stripe integration
  stripePriceId String? // Stripe Price ID for this bundle

  // Marketing
  heroImageUrl     String? // Hero image for bundle landing page
  ctaText          String  @default("Get This Bundle")
  recommendedFor   String? // "Families with multiple pets", "Pet lovers", etc.
  showOnHomepage   Boolean @default(false)
  homepagePriority Int     @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([active])
  @@index([holidayTheme])
  @@index([showOnHomepage])
}

// Email Campaign Tracking
model EmailCampaign {
  id          String @id @default(cuid())
  name        String // Campaign name (e.g., "Black Friday 2026 Announcement")
  subject     String // Email subject line
  campaignType String // "promotional", "holiday", "abandoned_cart", "newsletter"

  // Template configuration
  templateId   String // ID of the email template to use
  templateData String? // JSON with template variables

  // Targeting
  targetSegment String // "all_customers", "past_customers", "abandoned_carts", "loyalty_members"

  // Related promo/bundle
  promoCodeId     String? // Link to PromoCode if applicable
  holidayBundleId String? // Link to HolidayBundle if applicable

  // Scheduling
  scheduledFor DateTime? // When to send (null = draft)
  sentAt       DateTime? // When actually sent
  status       String    @default("draft") // "draft", "scheduled", "sending", "sent", "failed"

  // Performance metrics
  totalRecipients Int @default(0)
  delivered       Int @default(0)
  opened          Int @default(0)
  clicked         Int @default(0)
  converted       Int @default(0) // Number of purchases attributed
  revenue         Float @default(0) // Revenue attributed to this campaign

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin user who created this campaign

  @@index([status])
  @@index([scheduledFor])
  @@index([campaignType])
}
