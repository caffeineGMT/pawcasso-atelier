# Conversion Rate Optimization - Environment Variables

# Microsoft Clarity (Heatmaps & Session Recordings)
# Sign up at https://clarity.microsoft.com/
# Create project for your domain
# Copy Project ID (format: abcd1234)
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id_here

# Existing Analytics (already configured)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
NEXT_PUBLIC_PINTEREST_TAG_ID=123456789012
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-123456789
