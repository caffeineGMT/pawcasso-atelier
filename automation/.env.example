# TikTok/Reels Video Automation - Environment Variables
# Copy this file to .env and fill in your actual values

# ===== VERCEL BLOB STORAGE =====
# Get from: vercel env pull
VERCEL_BLOB_STORE_ID=your_store_id_here
BLOB_READ_WRITE_TOKEN=vercel_blob_XXX

# ===== NOTIFICATIONS =====
# Slack webhook for #marketing channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email for video notifications
NOTIFICATION_EMAIL=your-email@example.com

# ===== OPENAI (Caption Generation) =====
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXX

# ===== REMOTION (Video Rendering) =====
# NOTE: Set this in n8n credentials as HTTP Header Auth, not .env
# Get from: https://remotion.dev/dashboard
# X-Remotion-Token: your_token_here

# ===== SMTP (Email Sending - Optional) =====
# Use existing SMTP or Resend/SendGrid
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@pawcasso-atelier.vercel.app

# ===== TIKTOK API (Future Enhancement) =====
# For automated trending audio fetching
# TIKTOK_API_KEY=your_tiktok_key
# TIKTOK_API_SECRET=your_tiktok_secret
