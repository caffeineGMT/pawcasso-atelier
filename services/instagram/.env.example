# Instagram Graph API (required)
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Facebook App (for token refresh)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Google Chat Integration
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN

# n8n Integration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# Internal webhook auth (generate a random string)
INSTAGRAM_WEBHOOK_SECRET=your_random_secret_string

# Site URL (used for API calls)
NEXT_PUBLIC_SITE_URL=https://pawcassoatelier.com
